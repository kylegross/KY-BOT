# Copy to .env. Paste the BOT token locally, never into chat or source code.
DISCORD_TOKEN=

# none = normal startup; guild = test server; global = release to all servers.
# Set guild and fill DEV_GUILD_ID for your first test, then return to none.
COMMAND_SYNC=none
DEV_GUILD_ID=

LOG_LEVEL=INFO
LOG_DIR=logs
